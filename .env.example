# Get a free key at https://console.groq.com (no card required)
GROQ_API_KEY=your-groq-key-here

# Any Groq-hosted chat model that supports tool calling
GROQ_MODEL=openai/gpt-oss-120b

# The dataset in orders.json is a static snapshot; this pins the agent's
# notion of "today" so the fixed edge cases (delay counts, return-window
# math) stay consistent with the notes baked into orders.json.
# Format: YYYY-MM-DD. Leave unset to use the default (2026-07-29).
SIMULATED_TODAY=2026-07-29
